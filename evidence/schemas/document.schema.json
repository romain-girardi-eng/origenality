{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://origenality.com/schema/evidence-document-1.0.0.json",
  "title": "Origenality scholarly document",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "type",
    "title",
    "authors",
    "year",
    "bibliographic_record_ids",
    "source_url",
    "pdf_sha256",
    "pdf_bytes",
    "pdf_pages",
    "private_pdf_path",
    "extraction",
    "rights"
  ],
  "properties": {
    "id": {"type": "string", "pattern": "^doc:[0-9a-f]{20}$"},
    "type": {"const": "ScholarlyDocument"},
    "title": {"type": "string", "minLength": 1},
    "authors": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "year": {"type": "integer", "minimum": 1400, "maximum": 2100},
    "doi": {"type": ["string", "null"], "pattern": "^10\\."},
    "bibliographic_record_ids": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "map_resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "checked_on"],
      "properties": {
        "status": {"enum": ["resolved", "unresolved"]},
        "basis": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1},
        "checked_on": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}
      }
    },
    "source_url": {"type": "string", "format": "uri", "pattern": "^https://"},
    "pdf_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "pdf_bytes": {"type": "integer", "minimum": 1},
    "pdf_pages": {"type": "integer", "minimum": 1},
    "private_pdf_path": {
      "type": "string",
      "pattern": "^data/evidence/private/pdfs/[0-9a-f]{20}\\.pdf$"
    },
    "extraction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "tool", "extracted_on", "pages_path", "quality"],
      "properties": {
        "method": {"const": "pdftotext-layout-page-preserving"},
        "tool": {"type": "string", "minLength": 1},
        "extracted_on": {"type": "string", "format": "date"},
        "pages_path": {
          "type": "string",
          "pattern": "^data/evidence/private/extracted/[0-9a-f]{20}/pages\\.jsonl$"
        },
        "quality": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "pages",
            "pages_with_at_least_80_characters",
            "nonempty_ratio",
            "median_characters",
            "suspicious_glyphs",
            "suspicious_glyph_examples",
            "secondary_extractor",
            "secondary_extractor_replacement_glyphs",
            "quotable_pages",
            "pages_needing_text_review",
            "quotable"
          ],
          "properties": {
            "status": {"enum": ["native-text", "needs-ocr-review", "mixed-text-review"]},
            "pages": {"type": "integer", "minimum": 1},
            "pages_with_at_least_80_characters": {"type": "integer", "minimum": 0},
            "nonempty_ratio": {"type": "number", "minimum": 0, "maximum": 1},
            "median_characters": {"type": "integer", "minimum": 0},
            "suspicious_glyphs": {"type": "integer", "minimum": 0},
            "suspicious_glyph_examples": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["character", "count", "codepoint"],
                "properties": {
                  "character": {"type": "string", "minLength": 1, "maxLength": 1},
                  "count": {"type": "integer", "minimum": 1},
                  "codepoint": {"type": "string", "pattern": "^U\\+[0-9A-F]{4,6}$"}
                }
              }
            },
            "secondary_extractor": {"const": "mutool-draw-text"},
            "secondary_extractor_replacement_glyphs": {"type": "integer", "minimum": 0},
            "quotable_pages": {"type": "integer", "minimum": 0},
            "pages_needing_text_review": {"type": "integer", "minimum": 0},
            "quotable": {"type": "boolean"}
          }
        }
      }
    },
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lawful_access_basis",
        "license",
        "license_url",
        "rights_holder",
        "tdm_basis",
        "tdm_opt_out",
        "retention_rule",
        "commercial_use",
        "adaptation_allowed",
        "third_party_exclusions",
        "public_quote_policy",
        "public_quote_clearance",
        "review_status"
      ],
      "properties": {
        "lawful_access_basis": {
          "enum": ["open-access", "institutional-access", "owned-copy", "permission"]
        },
        "license": {"type": "string", "minLength": 1},
        "license_url": {"type": ["string", "null"], "format": "uri"},
        "rights_holder": {"type": ["string", "null"]},
        "tdm_basis": {
          "enum": ["open-license", "research-organisation", "general-tdm", "permission", "none"]
        },
        "tdm_opt_out": {"enum": ["not-found", "present", "not-applicable", "unchecked"]},
        "retention_rule": {"type": "string", "minLength": 1},
        "commercial_use": {"type": "boolean"},
        "adaptation_allowed": {"type": "boolean"},
        "third_party_exclusions": {"type": "array", "items": {"type": "string"}},
        "public_quote_policy": {
          "enum": ["licensed-verbatim", "short-quotation-only", "private-only"]
        },
        "public_quote_clearance": {"type": "boolean"},
        "review_status": {"enum": ["unreviewed", "license-verified", "permission-verified"]},
        "reviewed_on": {"type": ["string", "null"], "format": "date"},
        "review_note": {"type": ["string", "null"]}
      }
    }
  }
}
